# Authentication service configuration.
#
# Values without a default stop the process at startup if unset. That is
# deliberate: every one of them is a security control.

ENVIRONMENT=development

HTTP_PORT=5001
GRPC_PORT=6001

# --- Database (AWS RDS in production, local Postgres in development) ---------
DB_HOST=localhost
DB_PORT=5432
DB_USER=karlo
DB_PASSWORD=                      # REQUIRED
DB_NAME=karlo_auth
DB_SSLMODE=disable                # 'require' in production
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# --- Token signing ----------------------------------------------------------
# RS256. This service holds the private key; every other service holds only the
# public one. Generate a development pair with `make keys`.
JWT_PRIVATE_KEY_FILE=.keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=.keys/jwt-public.pem
JWT_KEY_ID=dev-1

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12

# --- Service-to-service credentials ----------------------------------------
# SERVICE_TOKEN is what this service presents when it calls others.
# ACCEPTED_SERVICE_TOKENS is the set it honours on its own gRPC port.
SERVICE_TOKEN=                    # REQUIRED
ACCEPTED_SERVICE_TOKENS=          # REQUIRED, comma-separated

NOTIFICATION_GRPC_ADDR=localhost:6004

# --- HTTP -------------------------------------------------------------------
# REQUIRED. There is no wildcard default: this API is credentialed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m

# --- Logging ----------------------------------------------------------------
# Logs are always written to stdout as JSON. Setting FLUENTD_HOST adds a second
# sink; leaving it unset is correct for local development and for platforms that
# collect stdout themselves.
#
# An unreachable collector degrades to stdout-only with a warning. It never
# stops the service from starting, and never blocks a request: shipping is
# asynchronous and bounded by FLUENTD_BUFFER_LIMIT.
LOG_LEVEL=info
# FLUENTD_HOST=localhost
FLUENTD_PORT=24224
FLUENTD_TAG_PREFIX=karlo
FLUENTD_ASYNC=true
FLUENTD_BUFFER_LIMIT=8388608
FLUENTD_TIMEOUT=3s

# --- Cache (Redis / ElastiCache) --------------------------------------------
# Optional. With REDIS_ADDR unset the service runs correctly against its
# database every time; nothing fails, it is simply slower.
#
# A cache failure is never a request failure: reads return a miss, writes are
# logged and dropped. The two primitives that cannot be faked — the login rate
# limiter and the idempotency claim — fall back to the database instead.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Short by design: a cache that takes longer than this to answer is slower than
# the query it fronts, so waiting on it makes the request worse.
REDIS_TIMEOUT=200ms
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
# Required by ElastiCache when encryption in transit is enabled, which it should
# be in production.
REDIS_TLS=false
