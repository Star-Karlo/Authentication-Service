# Authentication service, production.
#
# Apply platform-terraform first: this reads its outputs by remote state.

environment = "prod"

# Network placement. MUST match the platform's setting of the same name.
#
#   false — tasks in private subnets, egress through a NAT gateway.
#           Costs about $42/month (gateway plus data processing).
#   true  — tasks in public subnets with public IPs, no NAT gateway.
#           Still not reachable: the security group admits only the load
#           balancer. What it gives up is defence in depth — a compromised
#           task could reach the internet directly rather than through a
#           chokepoint you can watch.
#
# false is the safe default. Set true deliberately, knowing the trade.
cors_allowed_origins = ["https://tms.karlo.id", "https://fms.karlo.id"]
fluentd_host         = "fluentd.karlo.internal"

# The authentication service is on the path of every request in both products,
# so it gets a larger baseline than the others and never runs as a single task.
task_cpu      = 512
task_memory   = 1024
desired_count = 1
min_capacity  = 1
max_capacity  = 6

extra_environment = [
  { name = "DB_NAME", value = "karlo_auth" },
  { name = "DB_SSLMODE", value = "require" },
  { name = "ACCESS_TOKEN_TTL", value = "15m" },
  { name = "REFRESH_TOKEN_TTL", value = "720h" },
  { name = "BCRYPT_COST", value = "12" },
  { name = "LOGIN_RATE_LIMIT", value = "5" },
  { name = "LOGIN_RATE_WINDOW", value = "15m" },
]

# This service is the only holder of the JWT private key. No other service is
# granted it.


# `secret_arns` output. Copy this file to prod.tfvars and substitute them; the
# copy is gitignored because the ARNs name where production credentials live.
